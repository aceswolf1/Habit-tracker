# Copy this file to `.env` (same directory as docker-compose.yml) and edit.
# docker compose reads it automatically.

# Host port the app is served on. Browse to http://<NAS-IP>:${APP_PORT}
APP_PORT=3001

# --- Database ---------------------------------------------------------------
# By default the bundled `mongo` container is used and data is stored in the
# `mongo-data` Docker volume (persists on the NAS across restarts/updates).
MONGO_DB=pixelpaladin

# To use MongoDB Atlas (or any external Mongo) instead of the bundled one,
# uncomment and set this. The bundled mongo service still starts but is unused.
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/pixelpaladin?appName=Cluster0

# --- Prebuilt images (optional) --------------------------------------------
# Only needed when pulling prebuilt images (docker-compose.registry.yml) or when
# building+pushing with scripts/build-and-push.sh. Set to your registry namespace.
#   GHCR:        ghcr.io/yourname
#   Docker Hub:  docker.io/yourdockerhubuser
IMAGE_PREFIX=ghcr.io/your-name
IMAGE_TAG=latest

# --- Klipy GIF API (frontend Nitro server) ---------------------------------
# Required for GIF search/trending in the task modal. Server-side only —
# never put this value in client bundles or commit a real key.
# docker-compose.yml / docker-compose.registry.yml pass this into the
# frontend container as process.env.KLIPY_API_KEY (Compose does NOT auto-
# inject every .env key — only vars referenced under `environment:`).
KLIPY_API_KEY=
# Optional override (defaults to https://api.klipy.com)
# KLIPY_BASE_URL=https://api.klipy.com
